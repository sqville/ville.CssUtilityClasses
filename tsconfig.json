{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "jsx": "react",
    "jsxFactory": "qx.html.Jsx.createElement",
    "jsxFragmentFactory": "qx.html.Jsx.FRAGMENT"
  },
  "include": [
    "types/**/*",
    "source/**/*"
  ],
  "exclude": [
    "node_modules",
    "compiled"
  ]
}
