{
  "$schema": "https://qooxdoo.org/schema/compile-1-0-0.json",
  "meta": {
    "typescript": "types/qooxdoo.d.ts"
  },
  "targets": [
    {
      "type": "source",
      "outputPath": "compiled/source"
    },
    {
      "type": "build",
      "outputPath": "compiled/build"
    }
  ],
  "defaultTarget": "source",
  "locales": ["en"],
  "ignores": ["crypto", "require"],
  "environment": {
    "qx.nativeScrollBars": true,
    "qx.dyntheme": false,
    "qx.dynlocale": false,
    "qx.Promise.useNativePromise": true,
    "qx.command.bindEnabled": false,
    "qx.debug.ui.queue": false,
    "ville.appType": "web",
    "ville.ssg": false
  },
  "babel": {
    "options": {
      "targets": "last 2 Chrome versions, last 2 Firefox versions, last 2 Safari versions, last 2 Edge versions"
    }
  },
  "applications": [
    {
      "class": "villeuiapp.Application",
      "theme": "villeuiapp.theme.Theme",
      "name": "villeuiapp",
      "bootPath": "source/boot/villeuiapp",
      "loaderTemplate": "source/resource/ville/ville-loader-browser.tmpl.js",
      "exclude": [
        "ville.cssuc.include.*",
        "ville.cssuc.patch.*",
        "ville.cssuc.register.*",
        "ville.cssuc.resources.*",
        "ville.ui.adapter.*",
        "ville.ui.component.*",
        "ville.ui.container.*",
        "ville.ui.control.*",
        "ville.ui.experimental.*",
        "ville.ui.form.nextup.*",
        "ville.ui.icon.nextup.*",
        "ville.ui.indicator.*",
        "ville.ui.list.*",
        "ville.ui.menu.NavLink",
        "ville.ui.splitpane.*",
        "ville.ui.table.*",
        "ville.ui.tabview.*",
        "ville.ui.toolbar.*",
        "ville.ui.tree.*",
        "ville.ui.util.*"
      ],
      "group": ["main"],
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "shadcn",
        "ville.appType": "web"
      }
    },
    {
      "class": "mantineapp.Application",
      "theme": "ville.cssuc.theme.mantine.Theme",
      "name": "mantineapp",
      "bootPath": "source/boot/mantineapp",
      "include": ["ville.cssuc.patch.MLayoutItem", "ville.cssuc.patch.MWidget"],
      "group": ["mantine"],
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "mantine"
      }
    },
    {
      "class": "qxapp.Application",
      "theme": "qxapp.theme.Theme",
      "name": "qxapp",
      "bootPath": "source/boot/qxapp",
      "group": "mantine",
      "environment": {
        "ville.cssLayout": false,
        "ville.cssEngine": "mantine"
      }
    },
    {
      "class": "shadcnapp.Application",
      "theme": "ville.cssuc.theme.blankslate.Theme",
      "name": "shadcnapp",
      "bootPath": "source/boot/shadcnapp",
      "include": ["ville.cssuc.patch.MLayoutItem", "ville.cssuc.patch.MWidget"],
      "group": "tailwindcss",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "tailwindcss"
      }
    },
    {
      "class": "villewebsite.Application",
      "theme": "ville.cssuc.theme.blankslate.Theme",
      "name": "villewebsite",
      "bootPath": "source/boot/villewebsite",
      "include": ["villewebsite.pages.*"],
      "group": "mantine",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "mantine",
        "ville.appType": "web",
        "ville.ssg": true
      }
    },
    {
      "class": "tablerapp.Application",
      "theme": "tablerapp.theme.Theme",
      "name": "tablerapp",
      "bootPath": "source/boot/tablerapp",
      "include": ["ville.cssuc.patch.MLayoutItem", "ville.cssuc.patch.MWidget"],
      "group": "scss",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "scss"
      }
    },
    {
      "class": "twindapp.Application",
      "theme": "twindapp.theme.Theme",
      "name": "twindapp",
      "bootPath": "source/boot/twindapp",
      "include": ["ville.cssuc.patch.MLayoutItem", "ville.cssuc.patch.MWidget"],
      "group": "tailwindcss",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "tailwindcss"
      }
    },
    {
      "class": "villeui.Application",
      "theme": "villeui.theme.Theme",
      "name": "villeui",
      "bootPath": "source/boot/villeui",
      "include": ["ville.cssuc.*"],
      "group": "mantine",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "mantine"
      }
    },
    {
      "class": "carbonapp.Application",
      "theme": "carbonapp.theme.Theme",
      "name": "carbonapp",
      "bootPath": "source/boot/carbonapp",
      "group": "scss",
      "environment": {
        "ville.cssLayout": true,
        "ville.cssEngine": "scss"
      }
    }
  ]
}
